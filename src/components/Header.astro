---
import { nav, bookingHref } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="brand" aria-label="Antwerps Badhuis, naar de startpagina">
      <svg class="brand__mark" aria-hidden="true" viewBox="0 0 28 40" width="21" height="30">
        <rect x="1" y="7" width="26" height="32" rx="13" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
        <circle cx="14" cy="7" r="5" fill="none" stroke="var(--brass)" stroke-width="1.6"></circle>
        <circle cx="14" cy="16" r="2.2" fill="currentColor"></circle>
      </svg>
      <span class="brand__name">Antwerps Badhuis</span>
    </a>

    <nav class="nav" aria-label="Hoofdmenu">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn header__cta" href={bookingHref}>Reserveer</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-btn__bars" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" hidden>
    <nav aria-label="Mobiel menu">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const sheet = document.getElementById('mobile-menu');
  if (btn && sheet) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        sheet.hidden = false;
        requestAnimationFrame(() => sheet.classList.add('is-open'));
      } else {
        sheet.classList.remove('is-open');
        sheet.addEventListener('transitionend', () => {
          if (!sheet.classList.contains('is-open')) sheet.hidden = true;
        }, { once: true });
        // Fallback if no transition runs (reduced motion)
        setTimeout(() => { if (!sheet.classList.contains('is-open')) sheet.hidden = true; }, 400);
      }
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 68rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--green-900);
    color: var(--on-green);
    border-bottom: 1px solid var(--line-on-green);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav ul {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--on-green-soft);
    padding-block: 0.5rem;
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 1px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out);
  }
  .nav a[aria-current='page'] {
    color: var(--on-green);
  }
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--on-green);
    }
    .nav a:hover::after {
      transform: scaleX(1);
    }
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header__cta {
    min-height: 2.75rem;
    padding-inline: 1.25rem;
  }

  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    place-items: center;
  }
  .menu-btn__bars,
  .menu-btn__bars::before {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 260ms var(--ease-out);
  }
  .menu-btn__bars {
    position: relative;
    transform: translateY(-3px);
  }
  .menu-btn__bars::before {
    content: '';
    position: absolute;
    top: 6px;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars {
    transform: translateY(0) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  .sheet {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--green-900);
    padding: 1.5rem var(--gutter) 6rem;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 260ms ease,
      transform 320ms var(--ease-out);
  }
  .sheet.is-open {
    opacity: 1;
    transform: none;
  }
  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sheet a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-on-green);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
    text-decoration: none;
  }
  .sheet a[aria-current='page'] {
    color: var(--brass);
  }

  @media (max-width: 67.99rem) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .header__inner {
      gap: 0.75rem;
    }
  }
  @media (max-width: 30rem) {
    .brand {
      gap: 0.5rem;
    }
    .brand__mark {
      width: 16px;
      height: 23px;
    }
    .brand__name {
      font-size: 1.125rem;
    }
    .header__cta {
      min-height: 2.5rem;
      padding-inline: 1rem;
      font-size: 0.9375rem;
    }
    .header__actions {
      gap: 0.25rem;
    }
    .menu-btn {
      margin-right: -0.5rem;
    }
  }
</style>
