---
// Visible marker for information the client still has to supply.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span class="missing" title="Nog aan te leveren">
  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2 1v10M2 1.5h7l-1.6 2.5L9 6.5H2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
  <span><span class="missing__tag">ontbreekt</span> {label}</span>
</span>

<style>
  .missing {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.2em 0.65em;
    border: 1px dashed currentColor;
    border-radius: 6px;
    font: 500 0.875rem/1.35 var(--font-ui);
    letter-spacing: 0;
    opacity: 0.92;
    vertical-align: middle;
  }
  .missing__tag {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72em;
    letter-spacing: 0.08em;
    margin-right: 0.2em;
  }
</style>
