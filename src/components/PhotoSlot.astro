---
// Placeholder for a client photo. Swap for <img src alt> once photos are delivered.
interface Props {
  label: string;
  tone?: 'green' | 'porcelain';
  class?: string;
}
const { label, tone = 'green', class: className } = Astro.props;
---

<figure class:list={['photo', `photo--${tone}`, className]} role="img" aria-label={`Foto ontbreekt: ${label}`}>
  <figcaption>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m4 17 5-4.5 3.5 3 3-2.5L20 17"></path></svg>
    <span><strong>Foto ontbreekt</strong>{label}</span>
  </figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    min-height: 12rem;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    /* Tile joints: the bathhouse wall behind the missing photo */
    background-size: 44px 44px, 44px 44px, auto;
  }
  .photo--green {
    color: var(--on-green-soft);
    background-image:
      linear-gradient(rgb(238 241 236 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(238 241 236 / 0.07) 1px, transparent 1px),
      radial-gradient(120% 90% at 70% 20%, var(--green-700), var(--green-800) 60%, var(--green-900));
  }
  .photo--porcelain {
    color: var(--ink-soft);
    background-image:
      linear-gradient(rgb(19 33 29 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(19 33 29 / 0.07) 1px, transparent 1px),
      radial-gradient(120% 90% at 70% 20%, var(--porcelain), var(--porcelain-2) 60%, var(--porcelain-3));
  }
  figcaption {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  figcaption svg {
    flex: none;
    margin-top: 0.05rem;
  }
  figcaption strong {
    display: block;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
