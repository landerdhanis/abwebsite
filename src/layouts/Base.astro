---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyReserve from '../components/StickyReserve.astro';

interface Props {
  title: string;
  description: string;
  /** Selector the mobile booking bar hides behind (e.g. the hero). */
  stickyHideWhile?: string;
}
const { title, description, stickyHideWhile } = Astro.props;
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15322b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="nl_BE" />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyReserve hideWhileVisible={stickyHideWhile} />
  </body>
</html>
